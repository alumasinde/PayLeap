{% set prefix = query is defined and query ? query ~ '&' : '' %}
{% if pages > 1 %}
  <nav class="pager" aria-label="Pagination">
    {% if page > 1 %}
      <a class="btn-ghost btn-sm" href="?{{ prefix }}page={{ page - 1 }}">Previous</a>
    {% endif %}
    <span class="muted">Page {{ page }} of {{ pages }}{% if total is defined %} · {{ total }} {{ label|default('rows') }}{% endif %}</span>
    {% if page < pages %}
      <a class="btn-ghost btn-sm" href="?{{ prefix }}page={{ page + 1 }}">Next</a>
    {% endif %}
  </nav>
{% endif %}
