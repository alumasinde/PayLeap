{% extends 'layout.twig' %}

{% block title %}Users & access {% endblock %}

{% block body %}
  <section class="page-head">
    <span class="kicker">Users &amp; access</span>
    <h1>{{ current_company.company_name }}</h1>
    <p class="muted">Invite people, change what they can do, and remove access.</p>
  </section>

  <div class="grid-2">
    {% if can_invite %}
      <section class="panel">
        <h2>Invite someone</h2>
        <form class="stack" method="post" action="/app/access/invite">
          <input type="hidden" name="_token" value="{{ csrf_token() }}">

          <label class="field">
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required>
          </label>

          <label class="field">
            <span>Role</span>
            <select name="role_id" required>
              {% for role in roles %}
                <option value="{{ role.id }}">{{ role.name }}</option>
              {% endfor %}
            </select>
          </label>

          <button class="btn-primary" type="submit">Send invitation</button>
        </form>

        <h3>Pending invitations</h3>
        {% if pending %}
          <table class="list">
            <thead>
              <tr><th>Email</th><th>Role</th><th>Expires</th><th></th></tr>
            </thead>
            <tbody>
              {% for invite in pending %}
                <tr>
                  <td>{{ invite.email }}</td>
                  <td>{{ invite.role_name }}</td>
                  <td class="muted">{{ invite.expires_at }}</td>
                  <td>
                    <form method="post" action="/app/access/invites/{{ invite.id }}/revoke">
                      <input type="hidden" name="_token" value="{{ csrf_token() }}">
                      <button class="btn-ghost btn-sm" type="submit">Revoke</button>
                    </form>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="muted">No pending invitations.</p>
        {% endif %}
      </section>
    {% endif %}

    <section class="panel">
      <h2>Team</h2>
      <table class="list">
        <thead>
          <tr><th>Name</th><th>Roles</th>{% if can_manage %}<th></th>{% endif %}</tr>
        </thead>
        <tbody>
          {% for member in members %}
            <tr>
              <td>
                {{ member.first_name }} {{ member.last_name }}<br>
                <span class="muted">{{ member.email }}</span>
              </td>
              <td>{{ member.role_names ?: 'No role' }}</td>
              {% if can_manage %}
                <td>
                  {% if member.id != current_user.id %}
                    <form class="row-actions" method="post" action="/app/access/members/{{ member.id }}/role">
                      <input type="hidden" name="_token" value="{{ csrf_token() }}">
                      <select name="role_id" aria-label="Role for {{ member.first_name }} {{ member.last_name }}">
                        {% for role in roles %}
                          <option value="{{ role.id }}"{% if role.id in (assigned[member.id] ?? []) %} selected{% endif %}>{{ role.name }}</option>
                        {% endfor %}
                      </select>
                      <button class="btn-ghost btn-sm" type="submit">Save</button>
                    </form>
                    <form method="post" action="/app/access/members/{{ member.id }}/remove">
                      <input type="hidden" name="_token" value="{{ csrf_token() }}">
                      <button class="btn-ghost btn-sm" type="submit">Remove</button>
                    </form>
                  {% else %}
                    <span class="muted">You</span>
                  {% endif %}
                </td>
              {% endif %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
  </div>

  <section class="panel">
    <h2>Roles</h2>
    <p class="muted">Every company owns its roles. Invitations use these names; permissions are recorded in the database.</p>
    <ul class="role-list">
      {% for role in roles %}
        <li>
          <strong>{{ role.name }}</strong>
          <span class="muted">{{ role.permission_count }} permissions · {{ role.member_count }} members</span>
          {% if can('roles.manage') and role.key != 'owner' %}
            <a class="btn-ghost btn-sm" href="/app/access/roles/{{ role.id }}">Edit</a>
          {% elseif role.key == 'owner' %}
            <span class="chip">Fixed</span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </section>
{% endblock %}
