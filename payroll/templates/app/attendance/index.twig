{% extends 'layout.twig' %}
{% import 'partials/icons.twig' as icons %}

{% block title %}Attendance {% endblock %}

{% block body %}
  <section class="page-head">
    <span class="kicker">Time &amp; attendance</span>
    <h1>Attendance</h1>
    <p class="muted">The daily register for {{ date|date('l, j F Y') }}. Re-marking a day corrects the existing record.</p>
  </section>

  {% include 'partials/attendance_tabs.twig' %}

  <form class="filter-bar" method="get" action="/app/attendance">
    <label class="field inline-field">
      <span>Day</span>
      <input type="date" name="date" value="{{ date }}">
    </label>
    <button class="btn-ghost" type="submit">View day</button>
    {% if date != today %}<a class="text-link" href="/app/attendance">Today {{ icons.svg('arrow-right', 14) }}</a>{% endif %}
  </form>

  {% if holiday %}
    <p class="notice holiday-notice">
      {{ icons.svg('calendar', 15) }} <strong>{{ holiday.name }}</strong> is a public holiday. Unmarked staff are not counted as absent, and anyone who clocks in has their hours counted as holiday work on the timesheet.
      <a class="text-link" href="/app/settings?tab=leave#holidays">Manage holidays</a>
    </p>
  {% endif %}

  <div class="stat-grid">
    <div class="stat"><span class="stat-label">Present</span><strong>{{ summary.present }}</strong></div>
    <div class="stat"><span class="stat-label">Absent</span><strong>{{ summary.absent }}</strong></div>
    <div class="stat"><span class="stat-label">On leave</span><strong>{{ summary.on_leave }}</strong></div>
    <div class="stat"><span class="stat-label">Not marked</span><strong>{{ summary.unmarked }}</strong></div>
    <div class="stat"><span class="stat-label">Active staff</span><strong>{{ summary.total }}</strong></div>
  </div>

  {% if can_edit %}
    <section class="panel">
      <div class="panel-head">
        <div>
          <h2>Mark a record</h2>
          <p class="muted">Times are optional. A status on its own is enough for leave or absence.</p>
        </div>
      </div>
      {% if employees %}
        <form class="form-grid form-grid-4" method="post" action="/app/attendance">
          <input type="hidden" name="_token" value="{{ csrf_token() }}">
          <input type="hidden" name="work_date" value="{{ date }}">

          <label class="field">
            <span>Employee</span>
            <select name="employee_id" required>
              {% for employee in employees %}
                <option value="{{ employee.id }}">{{ employee.last_name }}, {{ employee.first_name }} ({{ employee.employee_no }})</option>
              {% endfor %}
            </select>
          </label>

          <label class="field">
            <span>Status</span>
            <select name="status" required>
              {% for key, label in statuses %}
                <option value="{{ key }}">{{ label }}</option>
              {% endfor %}
            </select>
          </label>

          <label class="field">
            <span>Clock in</span>
            <input type="time" name="clock_in">
          </label>

          <label class="field">
            <span>Clock out</span>
            <input type="time" name="clock_out">
          </label>

          <label class="field">
            <span>Source</span>
            <select name="source">
              {% for key, label in sources %}
                <option value="{{ key }}">{{ label }}</option>
              {% endfor %}
            </select>
          </label>

          <div class="form-actions">
            <button class="btn-primary" type="submit">Save record</button>
          </div>
        </form>
      {% else %}
        <p class="muted">Add people to the register before marking attendance.</p>
      {% endif %}
    </section>
  {% endif %}

  <section class="panel">
    <div class="panel-head">
      <h2>Register</h2>
      <span class="muted">{{ summary.total }} active employee{{ summary.total == 1 ? '' : 's' }}</span>
    </div>

    {% if rows %}
      <div class="table-wrap">
        <table class="list">
          <thead>
            <tr>
              <th>Employee</th>
              <th>Department</th>
              <th>Status</th>
              <th>Clock in</th>
              <th>Clock out</th>
              <th>Source</th>
            </tr>
          </thead>
          <tbody>
            {% for row in rows %}
              <tr>
                <td>
                  <a href="/app/employees/{{ row.id }}">{{ row.first_name }} {{ row.last_name }}</a><br>
                  <span class="muted mono">{{ row.employee_no }}</span>
                </td>
                <td>{{ row.department_name ?: '—' }}</td>
                <td>
                  {% if row.attendance_status %}
                    <span class="status status-{{ row.attendance_status }}">{{ statuses[row.attendance_status] ?? row.attendance_status }}</span>
                  {% elseif row.on_leave %}
                    <span class="status status-leave">On leave</span>
                  {% elseif holiday %}
                    <span class="status status-holiday">{{ holiday.name }}</span>
                  {% else %}
                    <span class="status">Not marked</span>
                  {% endif %}
                </td>
                <td class="mono">{{ row.clock_in ? row.clock_in|slice(0, 5) : '—' }}</td>
                <td class="mono">{{ row.clock_out ? row.clock_out|slice(0, 5) : '—' }}</td>
                <td class="muted">{{ row.source ? (sources[row.source] ?? row.source|capitalize) : '—' }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <div class="empty-inline">
        <p class="muted">No active employees on the register.</p>
        {% if can('employees.edit') %}<a class="btn-primary btn-sm" href="/app/employees/new">Add the first employee</a>{% endif %}
      </div>
    {% endif %}
  </section>

  <section class="panel">
    <div class="panel-head">
      <div>
        <h2>Clock sources</h2>
        <p class="muted">A terminal writes the same row as a manual mark, with its source kept for audit.</p>
      </div>
    </div>
    <div class="source-grid">
      <div class="source-card">
        <strong>Manual entry</strong>
        <span>HR marks or corrects a day in the register. In use.</span>
      </div>
      <div class="source-card">
        <strong>Biometric reader</strong>
        <span>Fingerprint punches post with source <span class="mono">biometric</span>. No terminal connected yet.</span>
      </div>
      <div class="source-card">
        <strong>Face scanner</strong>
        <span>Face punches post with source <span class="mono">face</span>. No scanner connected yet.</span>
      </div>
    </div>
  </section>
{% endblock %}
