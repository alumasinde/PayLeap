<dialog id="dialog-rates" aria-labelledby="rates-title">
  <div class="dialog-inner">
    <form method="dialog">
      <button class="dialog-x" aria-label="Close">×</button>
    </form>

    <h2 id="rates-title">Rates in force</h2>
    <p class="dialog-sub">In force from {{ rules.effective_from|long_date }}</p>

    <dl class="rate-grid">
      <div>
        <dt>NSSF</dt>
        <dd>{{ rules.nssf.employee_rate|pct }} of pay up to
          KSh {{ rules.nssf.upper_earnings_limit|number_format(0) }}, capped at
          KSh {{ (rules.nssf.upper_earnings_limit * rules.nssf.employee_rate)|number_format(0) }}</dd>
      </div>
      <div>
        <dt>SHIF</dt>
        <dd>{{ rules.shif.employee_rate|pct }} of gross, minimum KSh {{ rules.shif.minimum_monthly|number_format(0) }}</dd>
      </div>
      <div>
        <dt>Housing Levy</dt>
        <dd>{{ rules.housing_levy.employee_rate|pct }} employee, {{ rules.housing_levy.employer_rate|pct }} employer</dd>
      </div>
      <div>
        <dt>PAYE</dt>
        <dd>{{ rules.paye.bands[0].rate|pct }} to
          {{ rules.paye.bands[(rules.paye.bands|length) - 1].rate|pct }}, less
          KSh {{ rules.paye.personal_relief_monthly|number_format(0) }} relief</dd>
      </div>
      <div>
        <dt>Pension</dt>
        <dd>relieved up to KSh {{ rules.reliefs.pension_cap_monthly|number_format(0) }} a month</dd>
      </div>
      <div>
        <dt>Mortgage interest</dt>
        <dd>owner-occupied, up to KSh {{ rules.reliefs.mortgage_interest_cap_monthly|number_format(0) }} a month</dd>
      </div>
      <div>
        <dt>Insurance relief</dt>
        <dd>{{ rules.reliefs.insurance_relief_rate|pct }} of premiums, up to
          KSh {{ rules.reliefs.insurance_relief_cap_monthly|number_format(0) }} of relief</dd>
      </div>
      <div>
        <dt>Employer</dt>
        <dd>{{ rules.nssf.employer_rate|pct }} NSSF, {{ rules.housing_levy.employer_rate|pct }} levy,
          KSh {{ rules.nita.employer_monthly|number_format(0) }} NITA</dd>
      </div>
    </dl>

    <p class="dialog-foot">
      Verified {{ rules.verified_on|long_date }}. Estimates only, not tax advice.
    </p>
  </div>
</dialog>

<dialog id="dialog-method" aria-labelledby="method-title">
  <div class="dialog-inner">
    <form method="dialog">
      <button class="dialog-x" aria-label="Close">×</button>
    </form>

    <h2 id="method-title">How the payslip is built</h2>
    <p class="dialog-sub">The order payroll applies every line.</p>

    <ol class="steps">
      <li>
        <strong>Statutory on cash pay</strong>
        <span>NSSF on its tiers, then SHIF and the Housing Levy on gross.</span>
      </li>
      <li>
        <strong>Reliefs before tax</strong>
        <span>Pension and owner-occupied mortgage interest reduce taxable pay within their caps.</span>
      </li>
      <li>
        <strong>PAYE</strong>
        <span>Bands on taxable pay, less personal relief and insurance relief, floored at zero.</span>
      </li>
      <li>
        <strong>After tax</strong>
        <span>Insurance premiums, HELB and SACCO come off the net, never below zero.</span>
      </li>
    </ol>

    <p class="dialog-foot">
      Benefits in kind are taxed in full once they pass KSh
      {{ rules.paye.non_cash_benefit_threshold_monthly|number_format(0) }} a month,
      and never change NSSF, SHIF or the levy.
    </p>
  </div>
</dialog>
