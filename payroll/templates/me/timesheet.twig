{% extends 'layout.twig' %}
{% import 'partials/icons.twig' as icons %}

{% block title %}Timesheet {% endblock %}

{% block body %}
  <header class="page-head">
    <span class="kicker">My account</span>
    <h1>Timesheet</h1>
    <p class="muted">{{ employee.first_name }} {{ employee.last_name }} ({{ employee.employee_no }}) · rostered shift, clock times and the hours won or lost against the roster.</p>
  </header>

  {% include 'partials/me_time_tabs.twig' %}

  <form class="filter-bar" method="get" action="/me/timesheet">
    <label class="field inline-field">
      <span>Month</span>
      <input type="month" name="month" value="{{ month }}">
    </label>
    <button class="btn-primary" type="submit">View timesheet</button>
  </form>

  {% include 'partials/timesheet_detail.twig' with {
    'employee': employee,
    'timesheet': timesheet,
    'month': month,
    'can_edit': false,
    'title': 'Daily record',
    'pager': {
      'page': page,
      'pages': pages,
      'total': total_rows,
      'label': 'days',
      'query': 'month=' ~ month
    }
  } only %}

  <p class="back-link"><a href="/me">Back to my profile</a></p>
{% endblock %}
