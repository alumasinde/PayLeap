{% extends 'layout.twig' %}

{% set editing = employee is not null %}

{% block title %}{{ editing ? 'Edit employee' : 'Add employee' }} {% endblock %}

{% block body %}
  <section class="page-head">
    <span class="kicker">Employees</span>
    <h1>{{ editing ? employee.first_name ~ ' ' ~ employee.last_name : 'Add an employee' }}</h1>
    <p class="muted">
      {% if editing %}
        Employee number {{ employee.employee_no }}
      {% else %}
        A number is generated if you leave it blank.
      {% endif %}
    </p>
  </section>

  {% if error %}<div class="alert">{{ error }}</div>{% endif %}

  <form class="panel" method="post" enctype="multipart/form-data" action="{{ editing ? '/app/employees/' ~ employee.id : '/app/employees' }}">
    <input type="hidden" name="_token" value="{{ csrf_token() }}">

    <fieldset class="form-section">
      <legend>Person</legend>
      <div class="form-grid">
        <label class="field">
          <span>Employee number</span>
          <input type="text" name="employee_no" maxlength="30" value="{{ values.employee_no ?? employee.employee_no ?? '' }}" placeholder="EMP-0001">
        </label>
        <label class="field">
          <span>First name</span>
          <input type="text" name="first_name" maxlength="80" required value="{{ values.first_name ?? employee.first_name ?? '' }}">
        </label>
        <label class="field">
          <span>Middle name</span>
          <input type="text" name="middle_name" maxlength="80" value="{{ values.middle_name ?? employee.middle_name ?? '' }}">
        </label>
        <label class="field">
          <span>Last name</span>
          <input type="text" name="last_name" maxlength="80" required value="{{ values.last_name ?? employee.last_name ?? '' }}">
        </label>
        <label class="field">
          <span>Gender</span>
          {% set currentGender = values.gender ?? employee.gender ?? '' %}
          <select name="gender">
            <option value="">Not recorded</option>
            {% for key, label in genders %}
              <option value="{{ key }}"{% if currentGender == key %} selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
          <small class="hint">Used for maternity and paternity eligibility.</small>
        </label>
        <label class="field">
          <span>Email</span>
          <input type="email" name="email" maxlength="190" value="{{ values.email ?? employee.email ?? '' }}">
        </label>
        <label class="field">
          <span>Phone</span>
          <input type="text" name="phone" maxlength="40" value="{{ values.phone ?? employee.phone ?? '' }}" placeholder="0712 345 678">
        </label>
        <label class="field">
          <span>Date of birth</span>
          <input type="date" name="dob" value="{{ values.dob ?? employee.dob ?? '' }}">
        </label>
        <label class="field">
          <span>Marital status</span>
          {% set currentMarital = values.marital_status ?? employee.marital_status ?? '' %}
          <select name="marital_status">
            <option value="">Not recorded</option>
            {% for key, label in marital_statuses %}
              <option value="{{ key }}"{% if currentMarital == key %} selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
        </label>
        <label class="field">
          <span>Address</span>
          <input type="text" name="address" maxlength="255" value="{{ values.address ?? employee.address ?? '' }}">
        </label>
        <label class="field">
          <span>Nationality</span>
          <input type="text" name="nationality" maxlength="80" value="{{ values.nationality ?? employee.nationality ?? '' }}" placeholder="Kenyan">
        </label>
        <label class="field">
          <span>Cost center</span>
          <input type="text" name="cost_center" maxlength="80" value="{{ values.cost_center ?? employee.cost_center ?? '' }}" placeholder="Front office">
        </label>
        <label class="field field-wide">
          <span>Photo</span>
          <input type="file" name="photo" accept="image/jpeg,image/png,image/webp">
          <small class="hint">JPG, PNG or WebP up to 2 MB. Shown on the profile.</small>
        </label>
        {% if editing and employee.photo_path %}
          <label class="field field-wide">
            <span><input type="checkbox" name="remove_photo" value="1"> Remove the current photo</span>
          </label>
        {% endif %}
      </div>
    </fieldset>

    <fieldset class="form-section">
      <legend>Emergency contact</legend>
      <div class="form-grid">
        <label class="field">
          <span>Name</span>
          <input type="text" name="next_of_kin_name" maxlength="120" value="{{ values.next_of_kin_name ?? next_of_kin.name ?? '' }}">
        </label>
        <label class="field">
          <span>Relationship</span>
          <input type="text" name="next_of_kin_relationship" maxlength="40" value="{{ values.next_of_kin_relationship ?? next_of_kin.relationship ?? '' }}" placeholder="Spouse">
        </label>
        <label class="field">
          <span>Phone</span>
          <input type="text" name="next_of_kin_phone" maxlength="40" value="{{ values.next_of_kin_phone ?? next_of_kin.phone ?? '' }}">
        </label>
        <label class="field">
          <span>Email</span>
          <input type="email" name="next_of_kin_email" maxlength="190" value="{{ values.next_of_kin_email ?? next_of_kin.email ?? '' }}">
        </label>
        <label class="field">
          <span>Address</span>
          <input type="text" name="next_of_kin_address" maxlength="255" value="{{ values.next_of_kin_address ?? next_of_kin.address ?? '' }}">
        </label>
      </div>
    </fieldset>

    <fieldset class="form-section">
      <legend>Employment</legend>
      <div class="form-grid">
        <label class="field">
          <span>Job title</span>
          <input type="text" name="job_title" maxlength="80" value="{{ values.job_title ?? employee.job_title ?? '' }}">
        </label>
        <label class="field">
          <span>Department</span>
          <select name="department_id">
            <option value="0">No department</option>
            {% for department in departments %}
              {% set selected = values.department_id ?? employee.department_id ?? 0 %}
              <option value="{{ department.id }}"{% if selected == department.id %} selected{% endif %}>{{ department.name }}</option>
            {% endfor %}
          </select>
        </label>
        <label class="field">
          <span>Reports to</span>
          {% set currentManager = values.manager_id ?? employee.manager_id ?? 0 %}
          <select name="manager_id">
            <option value="0">No manager</option>
            {% for manager in managers %}
              <option value="{{ manager.id }}"{% if currentManager == manager.id %} selected{% endif %}>{{ manager.last_name }}, {{ manager.first_name }} ({{ manager.employee_no }})</option>
            {% endfor %}
          </select>
          <small class="hint">The manager approves this person's leave.</small>
        </label>
        <label class="field">
          <span>Portal login</span>
          {% set currentUser = values.user_id ?? employee.user_id ?? 0 %}
          <select name="user_id">
            <option value="0">Not linked</option>
            {% for user in portal_users %}
              <option value="{{ user.id }}"{% if currentUser == user.id %} selected{% endif %}>{{ user.first_name }} {{ user.last_name }} ({{ user.email }})</option>
            {% endfor %}
          </select>
          <small class="hint">Links the employee to a login for self-service and team approvals.</small>
        </label>
        <label class="field">
          <span>Employment type</span>
          {% set currentType = values.employment_type ?? employee.employment_type ?? 'permanent' %}
          <select name="employment_type">
            {% for key, label in types %}
              <option value="{{ key }}"{% if currentType == key %} selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
        </label>
        <label class="field">
          <span>Start date</span>
          <input type="date" name="start_date" required value="{{ values.start_date ?? employee.start_date ?? '' }}">
        </label>
        <label class="field">
          <span>Exit date</span>
          <input type="date" name="exit_date" value="{{ values.exit_date ?? employee.exit_date ?? '' }}">
          <small class="hint">Leave blank while the person is still employed.</small>
        </label>
      </div>
    </fieldset>

    <fieldset class="form-section">
      <legend>Statutory numbers</legend>
      <div class="form-grid">
        <label class="field">
          <span>National ID</span>
          <input type="text" name="national_id" maxlength="30" value="{{ values.national_id ?? employee.national_id ?? '' }}">
        </label>
        <label class="field">
          <span>KRA PIN</span>
          <input type="text" name="kra_pin" maxlength="20" value="{{ values.kra_pin ?? employee.kra_pin ?? '' }}" placeholder="A012345678Z">
        </label>
        <label class="field">
          <span>NSSF number</span>
          <input type="text" name="nssf_number" maxlength="30" value="{{ values.nssf_number ?? employee.nssf_number ?? '' }}">
        </label>
        <label class="field">
          <span>SHIF number</span>
          <input type="text" name="shif_number" maxlength="30" value="{{ values.shif_number ?? employee.shif_number ?? '' }}">
        </label>
      </div>
    </fieldset>

    {% if can_salary %}
      <fieldset class="form-section">
        <legend>Pay</legend>
        <div class="form-grid">
          <label class="field">
            <span>Pay basis</span>
            {% set currentBasis = values.pay_basis ?? employee.pay_basis ?? 'monthly' %}
            <select name="pay_basis">
              {% for key, label in pay_basis %}<option value="{{ key }}"{% if currentBasis == key %} selected{% endif %}>{{ label }}</option>{% endfor %}
            </select>
          </label>
          <label class="field">
            <span>Pay rate (KES)</span>
            <input type="text" name="monthly_salary" inputmode="decimal" value="{{ values.monthly_salary ?? salary_display }}" placeholder="45000.00">
            <small class="hint">Monthly salary, daily rate or hourly rate, matching the pay basis. Partial months are prorated automatically.</small>
          </label>
          <label class="field">
            <span>Pay effective from</span>
            <input type="date" name="salary_effective_date" value="{{ values.salary_effective_date ?? (editing ? 'now'|date('Y-m-d') : (values.start_date ?? employee.start_date ?? 'now'|date('Y-m-d'))) }}">
            <small class="hint">{{ editing ? 'Defaults to today. Change it only when the new rate should start earlier or later.' : 'The date the first rate starts.' }}</small>
          </label>
        </div>
      </fieldset>
    {% endif %}

    {% if can_bank %}
      <fieldset class="form-section">
        <legend>Bank</legend>
        <div class="form-grid">
          <label class="field">
            <span>Bank name</span>
            <input type="text" name="bank_name" maxlength="80" value="{{ values.bank_name ?? employee.bank_name ?? '' }}">
          </label>
          <label class="field">
            <span>Branch</span>
            <input type="text" name="bank_branch" maxlength="80" value="{{ values.bank_branch ?? employee.bank_branch ?? '' }}">
          </label>
          <label class="field">
            <span>Account number</span>
            <input type="text" name="bank_account" maxlength="40" value="{{ values.bank_account ?? employee.bank_account ?? '' }}">
          </label>
          <label class="field">
            <span>M-Pesa number</span>
            <input type="text" name="mpesa_no" maxlength="40" value="{{ values.mpesa_no ?? employee.mpesa_no ?? '' }}" placeholder="2547...">
            <small class="hint">Used for M-Pesa payment batches.</small>
          </label>
        </div>
      </fieldset>
    {% endif %}

    <div class="row-actions">
      <button class="btn-primary" type="submit">{{ editing ? 'Save changes' : 'Add employee' }}</button>
      <a class="btn-ghost" href="{{ editing ? '/app/employees/' ~ employee.id : '/app/employees' }}">Cancel</a>
    </div>
  </form>
{% endblock %}
