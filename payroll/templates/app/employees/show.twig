{% extends 'layout.twig' %}

{% block title %}{{ employee.first_name }} {{ employee.last_name }} — {{ app_name }}{% endblock %}

{% block body %}
  <section class="page-head">
    <span class="kicker">Employee {{ employee.employee_no }}</span>
    <h1>
      {{ employee.first_name }}
      {% if employee.middle_name %}{{ employee.middle_name }} {% endif %}
      {{ employee.last_name }}
    </h1>
    <p class="muted">
      {{ types[employee.employment_type] ?? employee.employment_type }}
      {% if employee.job_title %} · {{ employee.job_title }}{% endif %}
      {% if employee.department_name %} · {{ employee.department_name }}{% endif %}
    </p>

    <div class="row-actions">
      <span class="chip{% if employee.status == 'active' %} on{% endif %}">
        {{ employee.status == 'active' ? 'Active' : 'Archived' }}
      </span>

      {% if can_edit %}
        <a class="btn-ghost btn-sm" href="/app/employees/{{ employee.id }}/edit">Edit</a>

        {% if employee.status == 'active' %}
          <form class="row-actions" method="post" action="/app/employees/{{ employee.id }}/archive">
            <input type="hidden" name="_token" value="{{ csrf_token() }}">
            <input type="date" name="exit_date" aria-label="Exit date" value="{{ 'now'|date('Y-m-d') }}">
            <button class="btn-ghost btn-sm" type="submit">Archive</button>
          </form>
        {% else %}
          <form method="post" action="/app/employees/{{ employee.id }}/reinstate">
            <input type="hidden" name="_token" value="{{ csrf_token() }}">
            <button class="btn-ghost btn-sm" type="submit">Reinstate</button>
          </form>
        {% endif %}
      {% endif %}
    </div>
  </section>

  <div class="grid-2">
    <section class="panel">
      <h2>Employment</h2>
      <dl class="facts">
        <div><dt>Employee number</dt><dd class="mono">{{ employee.employee_no }}</dd></div>
        <div><dt>Department</dt><dd>{{ employee.department_name ?: '—' }}</dd></div>
        <div><dt>Job title</dt><dd>{{ employee.job_title ?: '—' }}</dd></div>
        <div><dt>Type</dt><dd>{{ types[employee.employment_type] ?? employee.employment_type }}</dd></div>
        <div><dt>Started</dt><dd class="mono">{{ employee.start_date }}</dd></div>
        <div><dt>Exited</dt><dd class="mono">{{ employee.exit_date ?: '—' }}</dd></div>
      </dl>
    </section>

    <section class="panel">
      <h2>Contact</h2>
      <dl class="facts">
        <div><dt>Email</dt><dd>{{ employee.email ?: '—' }}</dd></div>
        <div><dt>Phone</dt><dd class="mono">{{ employee.phone ?: '—' }}</dd></div>
      </dl>
    </section>
  </div>

  <div class="grid-2">
    <section class="panel">
      <h2>Statutory</h2>
      <dl class="facts">
        <div><dt>National ID</dt><dd class="mono">{{ employee.national_id ?: '—' }}</dd></div>
        <div><dt>KRA PIN</dt><dd class="mono">{{ employee.kra_pin ?: '—' }}</dd></div>
        <div><dt>NSSF</dt><dd class="mono">{{ employee.nssf_number ?: '—' }}</dd></div>
        <div><dt>SHIF</dt><dd class="mono">{{ employee.shif_number ?: '—' }}</dd></div>
      </dl>
    </section>

    {% if can_salary %}
      <section class="panel">
        <h2>Pay</h2>
        <dl class="facts">
          <div>
            <dt>Monthly salary</dt>
            <dd class="mono">
              {% if employee.monthly_salary_cents is not null %}
                KES {{ (employee.monthly_salary_cents / 100)|number_format(2) }}
              {% else %}
                —
              {% endif %}
            </dd>
          </div>
        </dl>
      </section>
    {% endif %}
  </div>

  {% if can_bank %}
    <section class="panel">
      <h2>Bank</h2>
      <dl class="facts">
        <div><dt>Bank</dt><dd>{{ employee.bank_name ?: '—' }}</dd></div>
        <div><dt>Branch</dt><dd>{{ employee.bank_branch ?: '—' }}</dd></div>
        <div><dt>Account</dt><dd class="mono">{{ employee.bank_account ?: '—' }}</dd></div>
      </dl>
    </section>
  {% endif %}

  <p class="muted"><a href="/app/employees">Back to the register</a></p>
{% endblock %}
