{% extends 'layout.twig' %}

{% block title %}Leave — {{ app_name }}{% endblock %}

{% block body %}
  <section class="page-head">
    <span class="kicker">Leave &amp; absence</span>
    <h1>Leave</h1>
    <p class="muted">
      Requests and balances for the team.
      {% if pending_count > 0 %}{{ pending_count }} waiting for a decision.{% else %}Nothing is pending.{% endif %}
      {% if can('settings.manage') %}<a class="text-link" href="/app/settings?tab=leave">Leave policy and holidays</a>{% endif %}
    </p>
  </section>

  <nav class="page-tabs" aria-label="Leave views">
    <a class="{{ view == 'requests' ? 'is-active' : '' }}" href="/app/leave">Requests</a>
    <a class="{{ view == 'balances' ? 'is-active' : '' }}" href="/app/leave?view=balances">Balances</a>
    <a class="{{ view == 'planner' ? 'is-active' : '' }}" href="/app/leave?view=planner">Planner</a>
  </nav>

  {% if view == 'balances' %}
    <form class="filter-bar" method="get" action="/app/leave">
      <input type="hidden" name="view" value="balances">
      <label class="field inline-field">
        <span>Employee</span>
        <select name="employee_id">
          {% for employee in employees %}
            <option value="{{ employee.id }}"{% if selected_employee and employee.id == selected_employee.id %} selected{% endif %}>{{ employee.last_name }}, {{ employee.first_name }} ({{ employee.employee_no }})</option>
          {% endfor %}
        </select>
      </label>
      <label class="field inline-field">
        <span>Year</span>
        <input type="number" name="year" min="2000" max="2100" step="1" value="{{ year }}">
      </label>
      <button class="btn-primary" type="submit">View balances</button>
    </form>

    <section class="panel">
      {% if selected_employee %}
        <div class="panel-head">
          <div>
            <h2>{{ selected_employee.first_name }} {{ selected_employee.last_name }}</h2>
            <p class="muted">{{ selected_employee.employee_no }} · {{ year }}</p>
          </div>
        </div>
        <div class="table-wrap">
          <table class="list">
            <thead>
              <tr>
                <th>Leave type</th>
                <th class="num">Entitlement</th>
                <th class="num">Accrued</th>
                <th class="num">Taken</th>
                <th class="num">Pending</th>
                <th class="num">Available</th>
              </tr>
            </thead>
            <tbody>
              {% for balance in balances %}
                <tr>
                  <td>{{ balance.name }}</td>
                  <td class="num mono">{{ balance.days_per_year == balance.days_per_year|round ? balance.days_per_year|number_format(0) : balance.days_per_year|number_format(1) }}</td>
                  <td class="num mono">{{ balance.accrued == balance.accrued|round ? balance.accrued|number_format(0) : balance.accrued|number_format(1) }}</td>
                  <td class="num mono">{{ balance.taken == balance.taken|round ? balance.taken|number_format(0) : balance.taken|number_format(1) }}</td>
                  <td class="num mono">{{ balance.pending == balance.pending|round ? balance.pending|number_format(0) : balance.pending|number_format(1) }}</td>
                  <td class="num mono">{{ balance.available == balance.available|round ? balance.available|number_format(0) : balance.available|number_format(1) }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <p class="hint">
          Entitlement is the yearly policy. Accrued and Available come from posted ledger transactions; Available is the ledger balance less pending days for {{ year }}. Viewing this page never changes a balance.
          {% if selected_employee and not selected_employee.gender %}
            Gender is not recorded for this employee; maternity and paternity balances are shown until it is set on the employee record.
          {% endif %}
        </p>
      {% else %}
        <p class="muted">Add people to the register before checking balances.</p>
      {% endif %}
    </section>

    {% if exceptions %}
      <section class="panel">
        <div class="panel-head">
          <div>
            <h2>Carry-over review</h2>
            <p class="muted">Expired batches are flagged for HR by default. Nothing is forfeited until someone chooses to forfeit it.</p>
          </div>
        </div>
        <div class="table-wrap">
          <table class="list">
            <thead><tr><th>Employee</th><th>Type</th><th>Batch</th><th class="num">Days</th><th>Action</th></tr></thead>
            <tbody>
              {% for exception in exceptions %}
                <tr>
                  <td>{{ exception.first_name }} {{ exception.last_name }}<br><span class="muted mono">{{ exception.employee_no }}</span></td>
                  <td>{{ exception.leave_type }}</td>
                  <td class="mono">{{ exception.period_start|date('d/m/Y') }} – {{ exception.period_end|date('d/m/Y') }}<br><span class="muted">expires {{ exception.expiry_date|date('d/m/Y') }}</span></td>
                  <td class="num mono">{{ exception.days|number_format(2) }}</td>
                  <td>
                    <div class="row-actions">
                      <form method="post" action="/app/leave/exceptions/{{ exception.id }}/resolve">
                        <input type="hidden" name="_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="action" value="retain">
                        <button class="btn-ghost btn-xs" type="submit">Retain</button>
                      </form>
                      <form method="post" action="/app/leave/exceptions/{{ exception.id }}/resolve">
                        <input type="hidden" name="_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="action" value="forfeit">
                        <button class="btn-ghost btn-xs" type="submit">Forfeit</button>
                      </form>
                    </div>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>
    {% endif %}

    {% if statutory_rules %}
      <section class="panel">
        <h2>Statutory basis</h2>
        <div class="table-wrap">
          <table class="list">
            <thead><tr><th>Rule</th><th class="num">Value</th><th>Citation</th></tr></thead>
            <tbody>
              {% for rule in statutory_rules %}
                <tr><td>{{ rule.code }}</td><td class="num mono">{{ rule.value_decimal ?? rule.value_text }}</td><td>{{ rule.citation }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>
    {% endif %}
  {% elseif view == 'planner' %}
    <form class="filter-bar" method="get" action="/app/leave">
      <input type="hidden" name="view" value="planner">
      <label class="field inline-field"><span>Month</span><input type="number" name="month" min="1" max="12" value="{{ month }}"></label>
      <label class="field inline-field"><span>Year</span><input type="number" name="year" min="2000" max="2100" value="{{ year }}"></label>
      <button class="btn-primary" type="submit">Open planner</button>
    </form>
    <section class="panel">
      <div class="panel-head"><div><h2>{{ planner.label }}</h2><p class="muted">{{ planner.rows|length }} request(s) touch this month.</p></div></div>
      <div class="table-wrap">
        <table class="list">
          <thead><tr><th>Day</th><th>Leave</th></tr></thead>
          <tbody>
            {% for day in planner.days %}
              <tr{% if day.weekend %} class="row-off"{% endif %}>
                <td class="mono">{{ day.weekday }} {{ day.day }}</td>
                <td>
                  {% for item in day.leave %}<span class="shift-tag leave">{{ item.first_name }} {{ item.last_name }} · {{ item.leave_type }} · {{ item.status }}</span> {% else %}<span class="muted">—</span>{% endfor %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  {% else %}
    <div class="filter-row">
      <div class="stat-grid">
        <div class="stat"><span class="stat-label">Pending</span><strong>{{ pending_count }}</strong></div>
        <div class="stat"><span class="stat-label">Leave types</span><strong>{{ types|length }}</strong></div>
        <div class="stat"><span class="stat-label">Shown</span><strong>{{ requests|length }}</strong></div>
        <div class="stat"><span class="stat-label">Your decision</span><strong>{{ can_approve ? 'Allowed' : 'Read only' }}</strong></div>
      </div>
      <nav class="filter-bar" aria-label="Leave status">
        <a class="chip{{ filter_status == 'pending' ? ' on' }}" href="/app/leave?status=pending">Pending</a>
        <a class="chip{{ filter_status == 'approved' ? ' on' }}" href="/app/leave?status=approved">Approved</a>
        <a class="chip{{ filter_status == 'rejected' ? ' on' }}" href="/app/leave?status=rejected">Rejected</a>
        <a class="chip{{ filter_status == 'cancelled' ? ' on' }}" href="/app/leave?status=cancelled">Cancelled</a>
        <a class="chip{{ filter_status == 'all' ? ' on' }}" href="/app/leave?status=all">All</a>
      </nav>
    </div>

    <section class="panel">
      {% if requests %}
        <div class="table-wrap">
          <table class="list">
            <thead>
              <tr>
                <th>Employee</th>
                <th>Type</th>
                <th>Dates</th>
                <th class="num">Days</th>
                <th>Status</th>
                {% if can_approve %}<th>Decision</th>{% endif %}
              </tr>
            </thead>
            <tbody>
              {% for request in requests %}
                <tr>
                  <td>
                    <a href="/app/employees/{{ request.employee_id }}">{{ request.first_name }} {{ request.last_name }}</a><br>
                    <span class="muted mono">{{ request.employee_no }}{% if request.department_name %} · {{ request.department_name }}{% endif %}</span>
                  </td>
                  <td>{{ request.leave_type }}</td>
                  <td class="mono">{{ request.start_date|date('j M Y') }} – {{ request.end_date|date('j M Y') }}</td>
                  <td class="num mono">{{ request.days == request.days|round ? request.days|number_format(0) : request.days|number_format(1) }}</td>
                  <td>
                    <span class="status status-{{ request.status }}">{{ request.status|capitalize }}</span>
                    {% if request.status == 'pending' and request.total_steps > 1 %}<br><span class="muted">Step {{ request.current_step }} of {{ request.total_steps }}</span>{% endif %}
                    {% if request.decision_note %}<br><span class="muted">{{ request.decision_note }}</span>{% endif %}
                  </td>
                  {% if can_approve %}
                    <td>
                      {% if request.status == 'pending' %}
                        {% if actor_employee_id and request.employee_id == actor_employee_id %}
                          <span class="muted">Your request — decided by your manager</span>
                        {% else %}
                          <div class="row-actions">
                            <form method="post" action="/app/leave/{{ request.id }}/decide">
                              <input type="hidden" name="_token" value="{{ csrf_token() }}">
                              <input type="hidden" name="decision" value="approved">
                              <button class="btn-primary btn-xs" type="submit">Approve</button>
                            </form>
                            <form method="post" action="/app/leave/{{ request.id }}/decide">
                              <input type="hidden" name="_token" value="{{ csrf_token() }}">
                              <input type="hidden" name="decision" value="rejected">
                              <button class="btn-ghost btn-xs" type="submit">Reject</button>
                            </form>
                          </div>
                        {% endif %}
                      {% else %}
                        <span class="muted">
                          {% if request.decided_at %}{{ request.decided_at|date('j M Y') }}{% else %}Decided{% endif %}
                        </span>
                      {% endif %}
                    </td>
                  {% endif %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <div class="empty-inline">
          <p class="muted">No {{ filter_status == 'all' ? '' : filter_status }} requests{{ filter_status == 'all' ? ' yet' : '' }}.</p>
          <p class="hint">Requests raised by the team appear here for approval.</p>
        </div>
      {% endif %}
    </section>

    <section class="panel">
      <h2>Entitlement by type</h2>
      {% if types %}
        <div class="table-wrap">
          <table class="list">
            <thead>
              <tr><th>Type</th><th class="num">Days per year</th><th>Accrual</th><th>Who may take it</th><th>Paid</th><th>Document</th><th class="num">Carry-over</th></tr>
            </thead>
            <tbody>
              {% for type in types %}
                <tr>
                  <td>{{ type.name }}</td>
                  <td class="num mono">{{ type.days_per_year == type.days_per_year|round ? type.days_per_year|number_format(0) : type.days_per_year|number_format(1) }}</td>
                  <td>
                    {% if type.accrual_rule == 'monthly' %}
                      Monthly · {{ type.days_per_year / 12 == (type.days_per_year / 12)|round ? (type.days_per_year / 12)|number_format(0) : (type.days_per_year / 12)|number_format(2) }}/month
                    {% else %}
                      Full year upfront
                    {% endif %}
                    {% if type.accrual_start_months > 0 %}<br><span class="muted">after {{ type.accrual_start_months }} month{{ type.accrual_start_months == 1 ? '' : 's' }}</span>{% endif %}
                    <br><span class="muted">{{ type.day_basis == 'calendar' ? 'calendar days' : 'working days' }}</span>
                  </td>
                  <td>{{ {'any': 'Everyone', 'female': 'Female', 'male': 'Male'}[type.gender_restriction] ?? 'Everyone' }}</td>
                  <td>{{ type.paid ? 'Yes' : 'No' }}</td>
                  <td>{{ type.requires_document ? 'Required' : 'Not required' }}</td>
                  <td class="num mono">{{ type.carry_over_max > 0 ? type.carry_over_max|number_format(0) : '—' }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <p class="muted">No leave types are configured for this company.</p>
      {% endif %}
    </section>
  {% endif %}
{% endblock %}
