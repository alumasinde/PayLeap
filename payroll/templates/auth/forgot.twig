{% extends 'layout.twig' %}

{% block title %}Reset password {% endblock %}

{% block body %}
  <div class="auth-wrap">
    <div class="auth-card">
      <span class="kicker">Password</span>
      <h1>Reset it</h1>
      <p class="muted">Enter the email you use for Mshahara. If it is on file, a six-character temporary password arrives within a minute.</p>

      {% if error %}
        <div class="alert">{{ error }}</div>
      {% endif %}

      <form method="post" action="/forgot" class="stack">
        <input type="hidden" name="_token" value="{{ csrf_token() }}">

        <label class="field">
          <span>Email</span>
          <input type="email" name="email" value="{{ email|default('') }}" autocomplete="username" required autofocus>
        </label>

        <button class="btn-primary" type="submit">Send temporary password</button>
      </form>

      <p class="auth-links"><a href="/login">Back to sign in</a></p>
    </div>
  </div>
{% endblock %}
