{% extends 'layout.twig' %}
{% import 'partials/icons.twig' as icons %}

{% macro days(value) %}{{ value == value|round ? value|number_format(0) : value|number_format(2) }}{% endmacro %}

{% block title %}My leave — {{ app_name }}{% endblock %}

{% block body %}
  <section class="page-head">
    <span class="kicker">My account</span>
    <h1>My leave</h1>
    <p class="muted">{{ employee.first_name }} {{ employee.last_name }} ({{ employee.employee_no }}) · {{ year }} balances and your own requests.</p>
  </section>

  <div class="stat-grid">
    <div class="stat"><span class="stat-label">Available days</span><strong>{{ _self.days(available_days) }}</strong></div>
    <div class="stat"><span class="stat-label">Taken this year</span><strong>{{ _self.days(taken_days) }}</strong></div>
    <div class="stat"><span class="stat-label">Pending requests</span><strong>{{ pending_count }}</strong></div>
    <div class="stat"><span class="stat-label">Leave types</span><strong>{{ balances|length }}</strong></div>
  </div>

  <div class="grid-2">
    <section class="panel">
      <h2>Your balance</h2>
      {% if balances %}
        <div class="table-wrap">
          <table class="list">
            <thead>
              <tr>
                <th>Leave type</th>
                <th class="num">Entitlement</th>
                <th class="num">Taken</th>
                <th class="num">Pending</th>
                <th class="num">Available</th>
              </tr>
            </thead>
            <tbody>
              {% for balance in balances %}
                <tr>
                  <td>{{ balance.name }}</td>
                  <td class="num mono">{{ _self.days(balance.days_per_year) }}</td>
                  <td class="num mono">{{ _self.days(balance.taken) }}</td>
                  <td class="num mono">{{ _self.days(balance.pending) }}</td>
                  <td class="num mono">{{ _self.days(balance.available) }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <p class="hint">Available is entitlement less approved and pending days for {{ year }}. Maternity and paternity appear only when they apply to your record.</p>
      {% else %}
        <p class="muted">No leave types are configured for you yet. Ask HR.</p>
      {% endif %}
    </section>

    <section class="panel">
      <h2>Apply for leave</h2>
      {% if balances %}
        <form class="stack" method="post" action="/me/leave">
          <input type="hidden" name="_token" value="{{ csrf_token() }}">
          <label class="field">
            <span>Leave type</span>
            <select name="leave_type_id" required>
              {% for balance in balances %}
                <option value="{{ balance.id }}"{% if balance.available <= 0 %} disabled{% endif %}>
                  {{ balance.name }} — {{ _self.days(balance.available) }} day{{ balance.available == 1 ? '' : 's' }} left
                </option>
              {% endfor %}
            </select>
          </label>
          <label class="field">
            <span>Start date</span>
            <input type="date" name="start_date" min="{{ today }}" required>
          </label>
          <label class="field">
            <span>End date</span>
            <input type="date" name="end_date" min="{{ today }}" required>
          </label>
          <label class="field">
            <span>Reason</span>
            <textarea name="reason" rows="3" maxlength="255" placeholder="Optional note for your approver"></textarea>
          </label>
          <p class="hint">Dates are calendar days, inclusive. A request needs a free date range and enough available days. Your manager or HR decides it; you cannot approve your own leave.</p>
          <button class="btn-primary" type="submit">Send request</button>
        </form>
      {% else %}
        <p class="muted">Leave types must be set up before you can apply.</p>
      {% endif %}
    </section>
  </div>

  <section class="panel">
    <div class="panel-head">
      <div>
        <h2>My requests</h2>
        <p class="muted">Everything you have asked for, newest first.</p>
      </div>
    </div>

    {% if requests %}
      <div class="table-wrap">
        <table class="list">
          <thead>
            <tr>
              <th>Type</th>
              <th>Dates</th>
              <th class="num">Days</th>
              <th>Status</th>
              <th>Requested</th>
              <th>Decision</th>
            </tr>
          </thead>
          <tbody>
            {% for request in requests %}
              <tr>
                <td>{{ request.leave_type }}{% if request.reason %}<br><span class="muted">{{ request.reason }}</span>{% endif %}</td>
                <td class="mono">{{ request.start_date|date('j M Y') }} – {{ request.end_date|date('j M Y') }}</td>
                <td class="num mono">{{ _self.days(request.days) }}</td>
                <td><span class="status status-{{ request.status }}">{{ request.status|capitalize }}</span></td>
                <td class="mono">{{ request.created_at|date('j M Y') }}</td>
                <td>
                  {% if request.decision_note %}
                    {{ request.decision_note }}
                  {% elseif request.decided_at %}
                    <span class="muted">Decided {{ request.decided_at|date('j M Y') }}</span>
                  {% else %}
                    <span class="muted">Awaiting decision</span>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <div class="empty-inline">
        <p class="muted">You have not requested leave yet.</p>
        <p class="hint">Use the form above to send your first request.</p>
      </div>
    {% endif %}
  </section>

  <p class="back-link"><a href="/me">Back to my account</a></p>
{% endblock %}
