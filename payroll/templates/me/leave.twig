{% extends 'layout.twig' %}
{% import 'partials/icons.twig' as icons %}

{% macro days(value) %}{{ value == value|round ? value|number_format(0) : value|number_format(2) }}{% endmacro %}

{% block title %}Leave {% endblock %}

{% block body %}
  <header class="page-head page-head-row">
    <div>
      <span class="kicker">My account</span>
      <h1>Leave</h1>
      <p class="muted">{{ employee.first_name }} {{ employee.last_name }} ({{ employee.employee_no }}) · {{ year }} balances and your own requests.</p>
    </div>
    <div class="page-head-actions">
      <a class="btn-ghost btn-sm" href="/me/leave/planner">Team planner</a>
      {% if balances %}
        <button class="btn-primary" type="button" data-modal-open="leave-modal">{{ icons.svg('calendar', 16) }} Request leave</button>
      {% endif %}
    </div>
  </header>

  <div class="ts-layout">
    <section class="panel">
      <div class="panel-head">
        <div>
          <h2>My requests</h2>
          <p class="muted">Newest application first.</p>
        </div>
        <span class="chip">{{ total_requests }} total</span>
      </div>

      {% if requests %}
        <div class="table-wrap">
          <table class="list">
            <thead>
              <tr>
                <th>Type</th>
                <th>Dates</th>
                <th>Resumes</th>
                <th class="num">Days</th>
                <th>Status</th>
                <th>Requested</th>
                <th>Decision</th>
              </tr>
            </thead>
            <tbody>
              {% for request in requests %}
                <tr>
                  <td>
                    {{ request.leave_type }}
                    {% if request.reason %}<br><span class="muted">{{ request.reason }}</span>{% endif %}
                  </td>
                  <td class="mono">{{ request.start_date|date('j M Y') }} – {{ request.end_date|date('j M Y') }}</td>
                  <td class="mono">{{ request.end_date|date_modify('+1 day')|date('j M Y') }}</td>
                  <td class="num mono">{{ _self.days(request.days) }}</td>
                  <td>
                    <span class="status status-{{ request.status }}">{{ request.status|capitalize }}</span>
                    {% if request.status == 'pending' and request.total_steps > 1 %}<br><span class="muted">Step {{ request.current_step }} of {{ request.total_steps }}</span>{% endif %}
                  </td>
                  <td class="mono">{{ request.created_at|date('j M Y') }}</td>
                  <td>
                    {% if request.decision_note %}
                      {{ request.decision_note }}
                    {% elseif request.decided_at %}
                      <span class="muted">Decided {{ request.decided_at|date('j M Y') }}</span>
                    {% else %}
                      <span class="muted">Awaiting decision</span>
                    {% endif %}
                    {% if request.status in ['pending', 'approved'] %}
                      <form class="inline-form" method="post" action="/me/leave/{{ request.id }}/cancel">
                        <input type="hidden" name="_token" value="{{ csrf_token() }}">
                        <button class="btn-ghost btn-xs" type="submit">Cancel</button>
                      </form>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% include 'partials/pager.twig' with {
          'page': page,
          'pages': pages,
          'total': total_requests,
          'label': 'requests'
        } only %}
      {% else %}
        <div class="empty-inline">
          <p class="muted">You have not requested leave yet.</p>
          {% if balances %}<p class="hint">Use Request leave to send your first one.</p>{% endif %}
        </div>
      {% endif %}
    </section>

    <aside class="ts-side">
      <section class="panel">
        <div class="panel-head">
          <h2>Balance</h2>
          <span class="chip">{{ year }}</span>
        </div>

        {% if balances %}
          {% set entitlement_total = 0 %}
          {% set accrued_total = 0 %}
          {% set taken_total = 0 %}
          {% set available_total = 0 %}
          <table class="list summary-table">
            <thead>
              <tr>
                <th>Type</th>
                <th class="num">Accrued</th>
                <th class="num">Taken</th>
                <th class="num">Available</th>
              </tr>
            </thead>
            <tbody>
              {% for balance in balances %}
                {% set entitlement_total = entitlement_total + balance.days_per_year %}
                {% set accrued_total = accrued_total + balance.accrued %}
                {% set taken_total = taken_total + balance.taken %}
                {% set available_total = available_total + balance.available %}
                <tr>
                  <td>
                    {{ balance.name }}<br>
                    <small class="muted">of {{ _self.days(balance.days_per_year) }} entitled</small>
                  </td>
                  <td class="num mono">{{ _self.days(balance.accrued) }}</td>
                  <td class="num mono">
                    {{ _self.days(balance.taken) }}
                    {% if balance.pending > 0 %}<small class="muted">+{{ _self.days(balance.pending) }} pending</small>{% endif %}
                  </td>
                  <td class="num mono">{{ _self.days(balance.available) }}</td>
                </tr>
              {% endfor %}
            </tbody>
            <tfoot>
              <tr>
                <td>Total<br><small class="muted">of {{ _self.days(entitlement_total) }} entitled</small></td>
                <td class="num mono">{{ _self.days(accrued_total) }}</td>
                <td class="num mono">{{ _self.days(taken_total) }}</td>
                <td class="num mono">{{ _self.days(available_total) }}</td>
              </tr>
            </tfoot>
          </table>
          <p class="hint">Entitled is the full yearly policy. Accrued and Available come from posted ledger transactions; Available is the ledger balance less pending days. Merely opening this page does not create or change a balance.</p>
        {% else %}
          <p class="muted">No leave types are configured for you yet. Ask HR.</p>
        {% endif %}
      </section>
    </aside>
  </div>

  {% if ledger_activity %}
    <section class="panel">
      <div class="panel-head">
        <div>
          <h2>Ledger activity</h2>
          <p class="muted">The posted transactions behind the balance. Positive days are grants and reversals; negative days are usage and expiry.</p>
        </div>
      </div>
      <div class="table-wrap">
        <table class="list">
          <thead><tr><th>Date</th><th>Type</th><th>Transaction</th><th class="num">Days</th></tr></thead>
          <tbody>
            {% for entry in ledger_activity %}
              <tr>
                <td class="mono">{{ entry.effective_date|date('d/m/Y') }}</td>
                <td>{{ entry.leave_type }}</td>
                <td>{{ entry.note ?: entry.type }}</td>
                <td class="num mono">{{ entry.days > 0 ? '+' : '' }}{{ _self.days(entry.days) }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  {% endif %}

  {% if balances %}
    <dialog class="modal" id="leave-modal"{% if open_apply %} data-autoopen{% endif %}>
      <form class="modal-form" method="post" action="/me/leave/request">
        <input type="hidden" name="_token" value="{{ csrf_token() }}">
        <div class="modal-head">
          <div>
            <span class="kicker">Leave</span>
            <h2>Request leave</h2>
          </div>
          <button class="modal-close" type="button" data-modal-close aria-label="Close">{{ icons.svg('x', 18) }}</button>
        </div>

        {% for flash in flashes %}
          {% if flash.type == 'error' %}
            <div class="flash {{ flash.type }}">{{ flash.message }}</div>
          {% endif %}
        {% endfor %}

        <div class="modal-grid">
          <label class="field field-wide">
            <span>Leave type</span>
            <select name="leave_type_id" required>
              {% for balance in balances %}
                <option value="{{ balance.id }}"{% if balance.available <= 0 %} disabled{% endif %}>
                  {{ balance.name }} — {{ _self.days(balance.available) }} day{{ balance.available == 1 ? '' : 's' }} left
                </option>
              {% endfor %}
            </select>
          </label>
          <label class="field">
            <span>Start date</span>
            <input type="date" name="start_date" min="{{ today }}" required>
          </label>
          <label class="field">
            <span>End date</span>
            <input type="date" name="end_date" min="{{ today }}" required>
          </label>
          <label class="field field-wide">
            <span>Reason</span>
            <textarea name="reason" rows="3" maxlength="255" placeholder="Optional note for your approver"></textarea>
          </label>
        </div>

        <p class="hint">Dates are inclusive. Working-day types skip weekends and public holidays; calendar-day types count every date. A request needs a free date range and enough posted ledger days. Your manager or HR decides it; you cannot approve your own leave{% if leave_settings.multi_level_approval %} and a two-step request needs both decisions{% endif %}.</p>

        <div class="modal-actions">
          <button class="btn-ghost" type="button" data-modal-close>Cancel</button>
          <button class="btn-primary" type="submit">Send request</button>
        </div>
      </form>
    </dialog>
  {% endif %}

  <p class="back-link"><a href="/me">Back to my profile</a></p>
{% endblock %}
