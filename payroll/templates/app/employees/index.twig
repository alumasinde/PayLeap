{% extends 'layout.twig' %}

{% block title %}Employees {% endblock %}

{% block body %}
  <section class="page-head">
    <span class="kicker">Employees</span>
    <h1>People</h1>
    <p class="muted">The register every payroll run reads. {{ summary.active }} active, {{ summary.exited }} archived.</p>
  </section>

  <div class="stat-grid">
    <div class="stat"><span class="stat-label">Active</span><strong>{{ summary.active }}</strong></div>
    <div class="stat"><span class="stat-label">Archived</span><strong>{{ summary.exited }}</strong></div>
    <div class="stat"><span class="stat-label">Departments</span><strong>{{ departments|length }}</strong></div>
    {% if can_salary %}
      <div class="stat">
        <span class="stat-label">Monthly salary bill</span>
        <strong class="mono">KES {{ monthly_display }}</strong>
      </div>
    {% endif %}
  </div>

  {% if filters.attention %}
    <p class="notice">
      Showing active people with {% if filters.attention == 'no_manager' %}no manager{% else %}no department{% endif %}.
      <a class="text-link" href="/app/employees">Clear filter</a>
    </p>
  {% endif %}

  <form class="filter-bar" method="get" action="/app/employees">
    {% if filters.attention %}<input type="hidden" name="attention" value="{{ filters.attention }}">{% endif %}
    <input type="search" name="search" value="{{ filters.search }}" placeholder="Name, number, ID or KRA PIN" aria-label="Search employees">
    <select name="status" aria-label="Status">
      <option value="active"{% if filters.status == 'active' %} selected{% endif %}>Active</option>
      <option value="exited"{% if filters.status == 'exited' %} selected{% endif %}>Archived</option>
      <option value="all"{% if filters.status == 'all' %} selected{% endif %}>All</option>
    </select>
    <select name="department_id" aria-label="Department">
      <option value="0">All departments</option>
      {% for department in departments %}
        <option value="{{ department.id }}"{% if filters.department_id == department.id %} selected{% endif %}>{{ department.name }}</option>
      {% endfor %}
    </select>
    <button class="btn-ghost" type="submit">Filter</button>
    {% if can_edit %}<a class="btn-primary" href="/app/employees/new">Add employee</a>{% endif %}
  </form>

  <section class="panel">
    {% if employees %}
      {% if can_edit %}<form id="bulk-cost-center" method="post" action="/app/employees/cost-center"><input type="hidden" name="_token" value="{{ csrf_token() }}">{% endif %}
      <div class="table-wrap">
        <table class="list">
          <thead>
            <tr>
              {% if can_edit %}<th class="check"><input type="checkbox" data-check-all aria-label="Select all employees"></th>{% endif %}
              <th>No.</th>
              <th>Name</th>
              <th>Department</th>
              <th>Cost center</th>
              <th>Type</th>
              {% if can_salary %}<th class="num">Monthly</th>{% endif %}
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {% for employee in employees %}
              <tr>
                {% if can_edit %}<td class="check"><input type="checkbox" name="employee_ids[]" value="{{ employee.id }}" data-row-check aria-label="Select {{ employee.first_name }} {{ employee.last_name }}"></td>{% endif %}
                <td class="mono">{{ employee.employee_no }}</td>
                <td>
                  <a href="/app/employees/{{ employee.id }}">{{ employee.first_name }} {{ employee.last_name }}</a><br>
                  <span class="muted">{{ employee.email ?: employee.phone ?: '—' }}</span>
                </td>
                <td>{{ employee.department_name ?: '—' }}</td>
                <td>{{ employee.cost_center ?: '—' }}</td>
                <td>{{ types[employee.employment_type] ?? employee.employment_type }}</td>
                {% if can_salary %}
                  <td class="num mono">
                    {% if employee.monthly_salary_cents is not null %}
                      {{ (employee.monthly_salary_cents / 100)|number_format(2) }}
                    {% else %}
                      —
                    {% endif %}
                  </td>
                {% endif %}
                <td>
                  <span class="chip{% if employee.status == 'active' %} on{% endif %}">
                    {{ employee.status == 'active' ? 'Active' : 'Archived' }}
                  </span>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% if can_edit %}
        <div class="bulk-bar">
          <span class="muted"><strong data-selected-count>0</strong> selected. Filter by department, then select all if you want the whole team.</span>
          <label class="field">
            <span>Cost center</span>
            <input type="text" name="cost_center" maxlength="80" list="cost-centers" placeholder="e.g. Operations">
          </label>
          <button class="btn-primary btn-sm" type="submit">Apply to selected</button>
        </div>
        <datalist id="cost-centers">
          {% for center in cost_centers %}<option value="{{ center }}"></option>{% endfor %}
        </datalist>
      </form>
      {% endif %}

      {% if pages > 1 %}
        <nav class="pager">
          {% if page > 1 %}
            <a class="btn-ghost btn-sm" href="/app/employees?page={{ page - 1 }}&status={{ filters.status }}&department_id={{ filters.department_id }}&search={{ filters.search|url_encode }}{% if filters.attention %}&attention={{ filters.attention }}{% endif %}">Previous</a>
          {% endif %}
          <span class="muted">Page {{ page }} of {{ pages }} · {{ total }} people</span>
          {% if page < pages %}
            <a class="btn-ghost btn-sm" href="/app/employees?page={{ page + 1 }}&status={{ filters.status }}&department_id={{ filters.department_id }}&search={{ filters.search|url_encode }}{% if filters.attention %}&attention={{ filters.attention }}{% endif %}">Next</a>
          {% endif %}
        </nav>
      {% endif %}
    {% else %}
      <p class="muted">No people match this filter.</p>
      {% if can_edit %}<a class="btn-primary" href="/app/employees/new">Add the first employee</a>{% endif %}
    {% endif %}
  </section>

{% endblock %}
