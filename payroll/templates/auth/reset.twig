{% extends 'layout.twig' %}

{% block title %}Choose a password — {{ app_name }}{% endblock %}

{% block body %}
  <div class="auth-wrap">
    <div class="auth-card">
      <span class="kicker">Password</span>
      <h1>Choose a new one</h1>
      <p class="muted">{{ email }}</p>

      {% if error %}
        <div class="alert">{{ error }}</div>
      {% endif %}

      <form method="post" action="/reset/{{ token }}" class="stack">
        <input type="hidden" name="_token" value="{{ csrf_token() }}">

        <label class="field">
          <span>New password</span>
          <input type="password" name="password" autocomplete="new-password" required autofocus>
        </label>

        <label class="field">
          <span>Confirm password</span>
          <input type="password" name="password_confirmation" autocomplete="new-password" required>
        </label>

        <p class="hint">At least 10 characters. This signs out every other session.</p>

        <button class="btn-primary" type="submit">Update password</button>
      </form>
    </div>
  </div>
{% endblock %}
