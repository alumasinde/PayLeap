{% if results|length > 0 %}
  <div class="compare-grid">
    {% for result in results %}
      <article class="offer{% if result.delta == 0 %} best{% endif %}">
        <header class="offer-head">
          <span class="offer-label">Offer {{ result.label }}</span>
          {% if result.delta == 0 and results|length > 1 %}
            <span class="badge">Best</span>
          {% endif %}
        </header>

        <div class="offer-net">
          <span class="eyebrow">Take home</span>
          <strong>{{ result.slip.net|money }}</strong>
        </div>

        <dl class="offer-lines">
          <div><dt>Gross</dt><dd>{{ result.slip.gross|money }}</dd></div>
          <div><dt>NSSF + SHIF + levy</dt><dd>{{ result.statutory|money }}</dd></div>
          <div><dt>PAYE</dt><dd>{{ result.slip.paye|money }}</dd></div>
        </dl>

        {% if result.delta > 0 %}
          <p class="delta">−{{ result.delta|money }} a month</p>
        {% elseif results|length > 1 %}
          <p class="delta up">Leads by {{ best_margin|money }}</p>
        {% endif %}
      </article>
    {% endfor %}
  </div>

  <div class="meta-row">
    <span class="mono">{{ rules.id }} · rules from {{ rules.effective_from|long_date }}</span>
    <button type="button" class="link-btn" data-open="dialog-rates">Rates</button>
  </div>
{% else %}
  <div class="empty"><p>Enter at least one offer.</p></div>
{% endif %}

{% include 'dialogs.twig' %}
