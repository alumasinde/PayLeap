{% extends 'layout.twig' %}
{% import 'partials/icons.twig' as icons %}

{% block title %}Timesheet {% endblock %}

{% block body %}
  <section class="page-head">
    <span class="kicker">Time &amp; attendance</span>
    <h1>Timesheet</h1>
    <p class="muted">One person's month: rostered shift, clock times and the hours won or lost against the roster.</p>
  </section>

  {% include 'partials/attendance_tabs.twig' %}

  <form class="filter-bar" method="get" action="/app/attendance">
    <input type="hidden" name="view" value="timesheet">
    <label class="field inline-field">
      <span>Employee</span>
      <select name="employee_id">
        {% for employee in employees %}
          <option value="{{ employee.id }}"{% if selected_employee and employee.id == selected_employee.id %} selected{% endif %}>{{ employee.last_name }}, {{ employee.first_name }} ({{ employee.employee_no }})</option>
        {% endfor %}
      </select>
    </label>
    <label class="field inline-field">
      <span>Month</span>
      <input type="month" name="month" value="{{ month }}">
    </label>
    <button class="btn-primary" type="submit">View timesheet</button>
  </form>

  {% include 'partials/timesheet_detail.twig' with {
    'employee': selected_employee,
    'timesheet': timesheet,
    'month': month,
    'can_edit': can_edit
  } only %}
{% endblock %}
