{% extends 'layout.twig' %}

{% block body %}
  <section class="intro">
    <h1>What your salary really pays you.</h1>
    <p>NSSF, SHIF, Housing Levy and PAYE, in the order payroll applies them.</p>
  </section>

  {% include 'tabs.twig' %}

  <div class="workspace">
    <aside class="form-col">
      <form id="calc"
            class="panel"
            hx-post="/preview"
            hx-target="#result"
            hx-swap="innerHTML"
            hx-sync="this:replace"
            hx-indicator="#calc-spin"
            hx-trigger="submit, change, input changed delay:400ms from:#gross">

        <div class="panel-head">
          <h2>Your payroll data</h2>
        </div>

        <div class="period-row">
          <label class="mini-field">
            <span>Month</span>
            <select id="month" name="month">
              {% for value in month_options %}
                <option value="{{ value }}"{% if value == month %} selected{% endif %}>{{ value|month_name }}</option>
              {% endfor %}
            </select>
          </label>
          <label class="mini-field">
            <span>Year</span>
            <select id="year" name="year">
              {% for value in years %}
                <option value="{{ value }}"{% if value == year %} selected{% endif %}>{{ value }}</option>
              {% endfor %}
            </select>
          </label>
        </div>

        <label class="field">
          <span class="eyebrow">Monthly salary</span>
          <span class="amount-box">
            <span class="cur">KSh</span>
            <input id="gross" name="gross" inputmode="numeric" autocomplete="off"
                   value="{{ gross|number_format(0, '.', '') }}">
          </span>
        </label>

        <div class="presets">
          {% for preset in [30000, 60000, 100000, 250000] %}
            <button type="button" class="chip{% if gross == preset %} on{% endif %}"
                    data-preset="{{ preset }}">{{ preset|number_format(0) }}</button>
          {% endfor %}
        </div>

        <details class="extras">
          <summary>Pension, benefits, HELB, SACCO <span>Add</span></summary>

          <div class="extras-body">
            <div class="grid2">
              <label class="field">
                <span class="eyebrow">Pension</span>
                <span class="amount-box small">
                  <span class="cur">KSh</span>
                  <input name="pension" inputmode="numeric" value="{{ options.pension ?: '' }}">
                </span>
              </label>
              <label class="field">
                <span class="eyebrow">Mortgage</span>
                <span class="amount-box small">
                  <span class="cur">KSh</span>
                  <input name="mortgage" inputmode="numeric" value="{{ options.mortgage_interest ?: '' }}">
                </span>
              </label>
              <label class="field">
                <span class="eyebrow">Insurance</span>
                <span class="amount-box small">
                  <span class="cur">KSh</span>
                  <input name="insurance" inputmode="numeric" value="{{ options.insurance_premium ?: '' }}">
                </span>
              </label>
              <label class="field">
                <span class="eyebrow">Benefits in kind</span>
                <span class="amount-box small">
                  <span class="cur">KSh</span>
                  <input name="benefits" inputmode="numeric" value="{{ options.benefits_in_kind ?: '' }}">
                </span>
              </label>
              <label class="field">
                <span class="eyebrow">HELB</span>
                <span class="amount-box small">
                  <span class="cur">KSh</span>
                  <input name="helb" inputmode="numeric" value="{{ options.helb ?: '' }}">
                </span>
              </label>
              <label class="field">
                <span class="eyebrow">SACCO</span>
                <span class="amount-box small">
                  <span class="cur">KSh</span>
                  <input name="sacco" inputmode="numeric" value="{{ options.sacco ?: '' }}">
                </span>
              </label>
            </div>
          </div>
        </details>

        <button class="btn-primary" type="submit">
          <span class="spinner" id="calc-spin" aria-hidden="true"></span>
          <span>Calculate</span>
        </button>
      </form>

      {% if source == 'file' %}
        <p class="banner">Rates are coming from <code>config/rates.php</code> — the database is not connected.</p>
      {% endif %}
    </aside>

    <section class="result-col">
      <div id="result" role="region" aria-live="polite" aria-label="Payslip">
        {% include 'payslip.twig' %}
      </div>
    </section>
  </div>
{% endblock %}
