{% set values = values|default({}) %}
{% set errors = errors|default({}) %}

<form class="interest"
      hx-post="/interest"
      hx-target="#interest-slot"
      hx-swap="innerHTML"
      hx-sync="this:replace"
      hx-indicator="#interest-spin">

  <input type="hidden" name="source" value="{{ source|default('site') }}">
  <p class="hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label></p>

  <div class="form-grid">
    <label class="field-line">
      <span>Your name</span>
      <input name="name" value="{{ values.name|default('') }}" autocomplete="name" required>
      {% if errors.name %}<em>{{ errors.name }}</em>{% endif %}
    </label>

    <label class="field-line">
      <span>Work email</span>
      <input type="email" name="email" value="{{ values.email|default('') }}" autocomplete="email" required>
      {% if errors.email %}<em>{{ errors.email }}</em>{% endif %}
    </label>

    <label class="field-line">
      <span>Company</span>
      <input name="company" value="{{ values.company|default('') }}" autocomplete="organization">
    </label>

    <label class="field-line">
      <span>Employees paid</span>
      <select name="employees">
        <option value="">Select</option>
        {% for band in employee_bands %}
          <option value="{{ band }}"{% if values.employees|default('') == band %} selected{% endif %}>{{ band }}</option>
        {% endfor %}
      </select>
    </label>

    <label class="field-line">
      <span>Module</span>
      <select name="module">
        {% for key, module in modules %}
          <option value="{{ key }}"{% if module_key|default('payroll') == key %} selected{% endif %}>{{ module.name }}</option>
        {% endfor %}
      </select>
    </label>

    <label class="field-line wide">
      <span>What should we know? (optional)</span>
      <textarea name="message" rows="3">{{ values.message|default('') }}</textarea>
    </label>
  </div>

  {% if errors.form %}<p class="form-error">{{ errors.form }}</p>{% endif %}

  <button class="btn-primary" type="submit">
    <span class="spinner" id="interest-spin" aria-hidden="true"></span>
    <span>Request early access</span>
  </button>

  <p class="form-note">One reply from a person, within a working day. No newsletter.</p>
</form>
