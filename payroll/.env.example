APP_NAME="Mshahara Payroll"
APP_ENV=local
APP_DEBUG=1
APP_URL=http://127.0.0.1:8090
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mshahara_payroll
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_NAME=mshahara_payroll_session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

MAIL_DRIVER=file
MAIL_FROM="Mshahara Payroll <no-reply@mshaharacheck.co.ke>"
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
