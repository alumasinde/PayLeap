{% extends 'layout.twig' %}
{% import 'partials/icons.twig' as icons %}

{% block title %}Attendance — {{ app_name }}{% endblock %}

{% block body %}
  <header class="page-head">
    <span class="kicker">My account</span>
    <h1>Attendance</h1>
    <p class="muted">{{ employee.first_name }} {{ employee.last_name }} ({{ employee.employee_no }}) · your daily record for {{ timesheet.label }}.</p>
  </header>

  {% include 'partials/me_time_tabs.twig' %}

  <div class="ts-layout">
    <section class="panel">
      <div class="panel-head">
        <div>
          <h2>Daily record</h2>
          <p class="muted">Read-only. Clock times come from the terminal or a correction by HR.</p>
        </div>
      </div>

      <form class="filter-bar" method="get" action="/me/attendance">
        <label class="field inline-field">
          <span>Month</span>
          <input type="month" name="month" value="{{ month }}">
        </label>
        <button class="btn-primary" type="submit">View month</button>
      </form>

      {% set labels = {
        'present': 'Present',
        'late': 'Late',
        'absent': 'Absent',
        'leave': 'On leave',
        'holiday': 'Public holiday',
        'off': 'Rest day',
        'unmarked': 'Not marked',
        'upcoming': 'Upcoming'
      } %}

      <div class="table-wrap">
        <table class="list">
          <thead>
            <tr>
              <th>Date</th>
              <th>Day</th>
              <th>Shift</th>
              <th>Status</th>
              <th>Clock in</th>
              <th>Clock out</th>
              <th>Source</th>
            </tr>
          </thead>
          <tbody>
            {% for row in timesheet.rows %}
              <tr class="{{ row.row_class }}">
                <td class="mono">{{ row.date|date('d/m/Y') }}</td>
                <td>{{ row.day }}</td>
                <td>
                  {% if row.holiday %}
                    <span class="shift-tag holiday">{{ row.shift }}</span>
                  {% elseif row.status == 'leave' %}
                    <span class="shift-tag leave">{{ row.shift }}</span>
                  {% elseif row.status == 'off' %}
                    <span class="shift-tag off">{{ row.shift }}</span>
                  {% elseif row.shift != '—' %}
                    <span class="shift-tag">{{ row.shift }}</span>
                    <small class="mono muted">{{ row.shift_label }}</small>
                  {% else %}
                    <span class="muted">—</span>
                  {% endif %}
                </td>
                <td>
                  {% if row.status in ['present', 'late', 'absent', 'leave', 'holiday', 'off'] %}
                    <span class="status status-{{ row.status }}">{{ labels[row.status] }}</span>
                  {% elseif row.status == 'upcoming' %}
                    <span class="status">{{ labels[row.status] }}</span>
                  {% else %}
                    <span class="status">{{ labels[row.status] ?? 'Not marked' }}</span>
                  {% endif %}
                </td>
                <td class="mono">{{ row.clock_in ?: '—' }}</td>
                <td class="mono">{{ row.clock_out ?: '—' }}</td>
                <td class="muted">{{ row.source ? (sources[row.source] ?? row.source|capitalize) : '—' }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% include 'partials/pager.twig' with {
        'page': page,
        'pages': pages,
        'total': total_rows,
        'label': 'days',
        'query': 'month=' ~ month
      } only %}
    </section>

    <aside class="ts-side">
      <section class="panel">
        <h2>Summary</h2>
        <table class="list summary-table">
          <tbody>
            <tr><td>Present</td><td class="num mono">{{ timesheet.summary.days.present }}</td></tr>
            <tr><td>Absent</td><td class="num mono">{{ timesheet.summary.days.absent }}</td></tr>
            <tr><td>On leave</td><td class="num mono">{{ timesheet.summary.days.on_leave }}</td></tr>
            <tr><td>Rest days</td><td class="num mono">{{ timesheet.summary.days.off }}</td></tr>
            <tr><td>Public holidays</td><td class="num mono">{{ timesheet.summary.days.holiday }}</td></tr>
            <tr><td>Single clock</td><td class="num mono">{{ timesheet.summary.days.single_clock }}</td></tr>
          </tbody>
        </table>
        <p class="hint">Unmarked days are shown for past weekdays. Approved leave and public holidays are never counted as absence.</p>
      </section>
    </aside>
  </div>

  <p class="back-link"><a href="/me">Back to my profile</a></p>
{% endblock %}
