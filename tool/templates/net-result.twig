{% if solution %}
  <div class="result-card">
    <span class="eyebrow">Gross to ask for</span>
    <strong class="big">{{ solution.gross|money }}</strong>
    <p class="hint-line">
      Clears {{ target|money }} take-home{% if solution.net > target %}, {{ (solution.net - target)|money }} over
      because payroll works in whole shillings{% endif %}.
    </p>
  </div>

  {% include 'sheet.twig' with {'slip': solution, 'rows': solution_rows, 'rules': rules, 'year': year, 'month': month} only %}

  <div class="meta-row">
    <span class="mono">{{ rules.id }} · rules from {{ rules.effective_from|long_date }}</span>
    <button type="button" class="link-btn" data-open="dialog-rates">Rates</button>
  </div>

  <div class="actions-row">
    <a class="btn-primary" href="{{ pdf_url }}">Download PDF</a>
  </div>
{% else %}
  <div class="empty"><p>Enter the take-home you want.</p></div>
{% endif %}

{% include 'dialogs.twig' %}
