{% if slip.gross > 0 %}
  {% include 'sheet.twig' %}

  <div class="meta-row">
    <span class="mono">Rules from {{ rules.effective_from|long_date }}</span>
    <button type="button" class="link-btn" data-open="dialog-rates">Rates</button>
  </div>

  <section class="bands">
    <h3 class="eyebrow">PAYE bands</h3>
    <div class="band-list">
      {% for band in slip.bands %}
        {% if band.taxable > 0 %}
          <div class="band">
            <span><span class="mono">{{ band.taxable|number_format(0) }}</span> at {{ band.rate|pct }}</span>
            <span class="mono">{{ band.tax|money }}</span>
          </div>
        {% endif %}
      {% endfor %}
      <div class="band">
        <span>Personal relief</span>
        <span class="mono">−{{ slip.personal_relief|money }}</span>
      </div>
      {% if slip.insurance_relief > 0 %}
        <div class="band">
          <span>Insurance relief</span>
          <span class="mono">−{{ slip.insurance_relief|money }}</span>
        </div>
      {% endif %}
    </div>
  </section>

  <div class="actions-row">
    <a class="btn-primary" href="{{ pdf_url }}">Download PDF</a>
    <button class="btn-ghost" type="button"
            hx-post="/save" hx-include="#calc" hx-target="#saved" hx-swap="innerHTML">
      Share link
    </button>
  </div>
  <div id="saved" aria-live="polite"></div>
{% else %}
  <div class="empty">
    <p>Enter a salary to see the payslip.</p>
  </div>
{% endif %}

{% include 'dialogs.twig' %}
