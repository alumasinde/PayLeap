{% import 'partials/icons.twig' as icons %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{{ csrf_token() }}">
  <title>{% block title %}{{ app_name }}{% endblock %}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/app.css">
</head>
<body class="{% block body_class %}app-body{% endblock %}">
<a class="skip-link" href="#main">Skip to content</a>
{% if current_user %}
  {% set on_timesheet = 'view=timesheet' in current_query %}
  {% set on_balances = 'view=balances' in current_query %}
  {% set self_service = current_employee and not has_workspace %}
  <div class="app-layout">
    <aside class="sidebar" id="sidebar" aria-label="Sidebar">
      <div class="sidebar-top">
        <a class="side-brand" href="{{ portal == 'finance' ? '/finance' : (portal == 'ess' ? '/ess' : '/hr') }}">
          <span class="side-logo">{{ icons.svg('briefcase', 18) }}</span>
          <span class="side-brand-text">
            <strong>{{ app_name }}</strong>
            <small>HR &amp; payroll</small>
          </span>
        </a>
        <button class="side-close" type="button" data-sidebar-close aria-label="Close menu">{{ icons.svg('x', 18) }}</button>
      </div>

      <div class="side-user">
        <span class="avatar">{{ (current_user.first_name|first ~ current_user.last_name|first)|upper }}</span>
        <span class="side-user-meta">
          <strong>{{ current_user.first_name }} {{ current_user.last_name }}</strong>
          <small>{{ role_label }}</small>
        </span>
        <span class="presence" title="Signed in"></span>
      </div>

      <nav class="side-nav" aria-label="Main">
        {% if portal == 'ess' %}
          <a class="side-link{{ current_path == '/ess' ? ' is-active' : '' }}" href="/ess">
            {{ icons.svg('grid', 18) }}<span>Overview</span>
          </a>
        {% elseif portal == 'finance' %}
          <a class="side-link{{ current_path == '/finance' ? ' is-active' : '' }}" href="/finance">
            {{ icons.svg('grid', 18) }}<span>Dashboard</span>
          </a>
        {% else %}
          <a class="side-link{{ current_path == '/hr' or current_path == '/app' ? ' is-active' : '' }}" href="/hr">
            {{ icons.svg('grid', 18) }}<span>Dashboard</span>
          </a>
        {% endif %}

        {% if portal == 'hr' and can('employees.view') %}
          <details class="side-group"{{ current_path starts with '/app/employees' or current_path == '/app/departments' ? ' open' }}>
            <summary class="side-group-head">
              {{ icons.svg('users', 18) }}<span>People</span>{{ icons.svg('chevron-down', 14) }}
            </summary>
            <div class="side-group-body">
              <a class="side-sub{{ current_path == '/app/employees' and not ('status=exited' in current_query) ? ' is-active' : '' }}" href="/app/employees">Employees</a>
              <a class="side-sub{{ current_path == '/app/departments' ? ' is-active' : '' }}" href="/app/departments">Departments</a>
              <a class="side-sub{{ current_path == '/app/employees' and 'status=exited' in current_query ? ' is-active' : '' }}" href="/app/employees?status=exited">Archived employees</a>
            </div>
          </details>
        {% endif %}

        {% if portal == 'hr' and can('leave.view') %}
          <details class="side-group"{{ current_path starts with '/app/leave' ? ' open' }}>
            <summary class="side-group-head">
              {{ icons.svg('calendar', 18) }}<span>Leave &amp; absence</span>{{ icons.svg('chevron-down', 14) }}
            </summary>
            <div class="side-group-body">
              <a class="side-sub{{ current_path == '/app/leave' and not on_balances ? ' is-active' : '' }}" href="/app/leave">Leave requests</a>
              <a class="side-sub{{ current_path == '/app/leave' and on_balances ? ' is-active' : '' }}" href="/app/leave?view=balances">Balances</a>
            </div>
          </details>
        {% endif %}

        {% if portal == 'hr' and can('attendance.view') %}
          <details class="side-group"{{ current_path starts with '/app/attendance' or current_path starts with '/app/roster' ? ' open' }}>
            <summary class="side-group-head">
              {{ icons.svg('clock', 18) }}<span>Time &amp; attendance</span>{{ icons.svg('chevron-down', 14) }}
            </summary>
            <div class="side-group-body">
              <a class="side-sub{{ current_path == '/app/attendance' and not on_timesheet ? ' is-active' : '' }}" href="/app/attendance">Register</a>
              <a class="side-sub{{ current_path == '/app/attendance' and on_timesheet ? ' is-active' : '' }}" href="/app/attendance?view=timesheet">Timesheet</a>
              <a class="side-sub{{ current_path starts with '/app/roster' ? ' is-active' : '' }}" href="/app/roster">Shift roster</a>
            </div>
          </details>
        {% endif %}

        {% if portal == 'finance' and can('payroll.view') %}
          <a class="side-link{{ current_path starts with '/app/payroll' and current_path != '/app/payroll/approvals' ? ' is-active' : '' }}" href="/app/payroll">
            {{ icons.svg('wallet', 18) }}<span>Payroll runs</span>
          </a>
        {% endif %}

        {% if portal == 'finance' and can('payroll.approve') %}
          <a class="side-link{{ current_path == '/app/payroll/approvals' ? ' is-active' : '' }}" href="/app/payroll/approvals">
            {{ icons.svg('check-circle', 18) }}<span>Approvals</span>
          </a>
        {% endif %}

        {% if portal == 'finance' and can('employees.view') %}
          <a class="side-link{{ current_path starts with '/app/employees' ? ' is-active' : '' }}" href="/app/employees">
            {{ icons.svg('users', 18) }}<span>Employees</span><span class="side-tag">View only</span>
          </a>
        {% endif %}

        {% if portal == 'hr' and can('settings.manage') %}
          <a class="side-link{{ current_path == '/app/settings' and 'tab=documents' in current_query ? ' is-active' : '' }}" href="/app/settings?tab=documents">
            {{ icons.svg('file', 18) }}<span>Documents</span>
          </a>
        {% endif %}

        {% if portal == 'hr' and (can('users.manage') or can('users.invite') or can('settings.manage')) %}
          <details class="side-group"{{ current_path starts with '/app/access' or current_path starts with '/app/settings' ? ' open' }}>
            <summary class="side-group-head">
              {{ icons.svg('shield', 18) }}<span>Organisation</span>{{ icons.svg('chevron-down', 14) }}
            </summary>
            <div class="side-group-body">
              {% if can('users.manage') or can('users.invite') %}
                <a class="side-sub{{ current_path starts with '/app/access' ? ' is-active' : '' }}" href="/app/access">Users &amp; access</a>
              {% endif %}
              {% if can('settings.manage') %}
                <a class="side-sub{{ current_path starts with '/app/settings' and not ('tab=documents' in current_query) ? ' is-active' : '' }}" href="/app/settings">Settings</a>
              {% endif %}
            </div>
          </details>
        {% endif %}

        {% if portal == 'ess' %}
          <details class="side-group"{{ current_path == '/me' or current_path == '/me/profile' or current_path starts with '/me/' or current_path starts with '/ess/payslips' ? ' open' }}>
            <summary class="side-group-head">
              {{ icons.svg('user', 18) }}<span>My workspace</span>{{ icons.svg('chevron-down', 14) }}
            </summary>
            <div class="side-group-body">
              <a class="side-sub{{ current_path == '/me' or current_path == '/me/profile' ? ' is-active' : '' }}" href="/me">My profile</a>
              <a class="side-sub{{ current_path starts with '/ess/payslips' ? ' is-active' : '' }}" href="/ess/payslips">My payslips</a>
              <a class="side-sub{{ current_path == '/me/leave' ? ' is-active' : '' }}" href="/me/leave">My leave</a>
              <a class="side-sub{{ current_path == '/me/attendance' ? ' is-active' : '' }}" href="/me/attendance">My attendance</a>
              <a class="side-sub{{ current_path == '/me/timesheet' ? ' is-active' : '' }}" href="/me/timesheet">My timesheet</a>
              <a class="side-sub{{ current_path starts with '/me/documents' ? ' is-active' : '' }}" href="/me/documents">My documents</a>
              <a class="side-sub{{ current_path == '/me/account' ? ' is-active' : '' }}" href="/me/account">Account settings</a>
            </div>
          </details>

          {% if can('leave.approve.team') or can('leave.approve.all') %}
            <a class="side-link{{ current_path == '/ess/leave/approvals' ? ' is-active' : '' }}" href="/ess/leave/approvals">
              {{ icons.svg('calendar', 18) }}<span>Team leave</span>
            </a>
          {% endif %}
        {% endif %}

        {% if portal != 'ess' %}
          <a class="side-link{{ current_path == '/me/account' ? ' is-active' : '' }}" href="/me/account">
            {{ icons.svg('user', 18) }}<span>Account settings</span>
          </a>
        {% endif %}
      </nav>

      <div class="side-foot">
        <span>Mshahara HR</span>
        <span>v1.0</span>
      </div>
    </aside>

    <div class="sidebar-scrim" data-sidebar-close hidden></div>

    <div class="app-main">
      <header class="topbar">
        <button class="menu-btn" type="button" data-sidebar-toggle aria-label="Open menu">{{ icons.svg('menu', 20) }}</button>

        {% if memberships|length > 1 and current_company %}
          <form class="company-picker" method="post" action="/app/company" data-company-form>
            <input type="hidden" name="_token" value="{{ csrf_token() }}">
            {{ icons.svg('building', 16) }}
            <select name="company_id" data-company-select aria-label="Active company">
              {% for membership in memberships %}
                <option value="{{ membership.company_id }}"{% if current_company and membership.company_id == current_company.company_id %} selected{% endif %}>{{ membership.company_name }}</option>
              {% endfor %}
            </select>
            {{ icons.svg('chevron-down', 14) }}
            <button class="sr-only" type="submit">Switch company</button>
          </form>
        {% elseif current_company %}
          <span class="company-pill">{{ icons.svg('building', 16) }}{{ current_company.company_name }}</span>
        {% endif %}

        {% if portals|length > 1 %}
          <nav class="portal-switch" aria-label="Switch portal">
            {% for item in portals %}
              <a class="portal-link{{ item.active ? ' is-active' : '' }}" href="{{ item.path }}">{{ item.label }}</a>
            {% endfor %}
          </nav>
        {% endif %}

        {% if portal == 'hr' and can('employees.view') %}
          <form class="topbar-search" method="get" action="/app/employees" role="search">
            {{ icons.svg('search', 17) }}
            <input type="search" name="search" placeholder="Search employees" aria-label="Search employees">
          </form>
        {% endif %}

        <div class="topbar-actions">
          {% if portal != 'ess' %}
            {% set approvals = pending_approvals() %}
            {% if portal == 'finance' %}
              {% set bell_href = can('payroll.approve') ? '/app/payroll/approvals' : '/app/payroll' %}
            {% elseif can('leave.view') %}
              {% set bell_href = '/app/leave' %}
            {% else %}
              {% set bell_href = '/me' %}
            {% endif %}
            <a class="icon-btn" href="{{ bell_href }}" aria-label="Pending approvals{% if approvals > 0 %} ({{ approvals }}){% endif %}">
              {{ icons.svg('bell', 19) }}
              {% if approvals > 0 %}<span class="icon-badge">{{ approvals }}</span>{% endif %}
            </a>
          {% endif %}

          <details class="user-menu">
            <summary class="user-summary">
              <span class="avatar">{{ (current_user.first_name|first ~ current_user.last_name|first)|upper }}</span>
              <span class="user-meta">
                <strong>{{ current_user.first_name }} {{ current_user.last_name }}</strong>
                <small>{{ role_label }}</small>
              </span>
              {{ icons.svg('chevron-down', 14) }}
            </summary>
            <div class="user-pop">
              <div class="user-pop-head">
                <strong>{{ current_user.first_name }} {{ current_user.last_name }}</strong>
                <span>{{ current_user.email }}</span>
                <span class="chip on">{{ role_label }}</span>
              </div>
              {% if current_company %}
                <span class="pop-company">{{ icons.svg('building', 16) }}{{ current_company.company_name }}</span>
              {% endif %}
              <a class="pop-link" href="/me">{{ icons.svg('user', 16) }}My profile</a>
              <a class="pop-link" href="/me/account">{{ icons.svg('settings', 16) }}Account settings</a>
              <form method="post" action="/logout">
                <input type="hidden" name="_token" value="{{ csrf_token() }}">
                <button class="pop-link pop-button" type="submit">{{ icons.svg('log-out', 16) }}Sign out</button>
              </form>
            </div>
          </details>
        </div>
      </header>
{% endif %}

<main class="{{ current_user ? 'content' : 'auth-shell' }}" id="main">
  {% for flash in flashes %}
    <div class="flash {{ flash.type }}">{{ flash.message }}</div>
  {% endfor %}
  {% block body %}{% endblock %}
</main>

{% if current_user %}
    </div>
  </div>
{% endif %}
<script src="/app.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
