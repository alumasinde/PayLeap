{% extends 'layout.twig' %}
{% import 'partials/icons.twig' as icons %}

{% block title %}Account settings {% endblock %}

{% block body %}
  {% if current_user.must_change_password %}
    <div class="alert">You signed in with a temporary password. Choose a new password below to continue.</div>
  {% endif %}

  <section class="page-head">
    <span class="kicker">Account settings</span>
    <h1>Change password</h1>
    <p class="muted">Signed in as {{ current_user.first_name }} {{ current_user.last_name }} · {{ current_user.email }}{% if current_company %} · {{ current_company.company_name }}{% endif %}</p>
  </section>

  <section class="panel account-panel">
    <div class="panel-head">
      <div>
        <h2>Password</h2>
        <p class="muted">Use at least 8 characters. Changing it signs out your other devices.</p>
      </div>
    </div>

    <form class="stack" method="post" action="/me/password">
      <input type="hidden" name="_token" value="{{ csrf_token() }}">
      <label class="field">
        <span>Current password</span>
        <input type="password" name="current_password" autocomplete="current-password" required>
      </label>
      <label class="field">
        <span>New password</span>
        <input type="password" name="password" autocomplete="new-password" required>
      </label>
      <label class="field">
        <span>Confirm new password</span>
        <input type="password" name="password_confirmation" autocomplete="new-password" required>
      </label>
      <button class="btn-primary" type="submit">{{ icons.svg('shield', 16) }} Change password</button>
    </form>

    <p class="hint">Your name and employee details are maintained by HR. Ask HR if they need updating.</p>
  </section>
{% endblock %}
